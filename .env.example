# ── Runtime environment ───────────────────────────────────────────────
# Development / Staging / Production. Leave Development for local work.
ASPNETCORE_ENVIRONMENT=Development


# ── Database ──────────────────────────────────────────────────────────
ConnectionStrings__Default=postgresql://user:password@host.neon.tech/gestor_financiero?sslmode=require


# ── SMTP (email) ──────────────────────────────────────────────────────
Smtp__UseFakeSender=true
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromName=Gestor Financiero
Smtp__FromAddress=
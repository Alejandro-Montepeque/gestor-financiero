<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>gestorfinanciero-web-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestorFinanciero.Application\GestorFinanciero.Application.csproj" />
    <ProjectReference Include="..\GestorFinanciero.Infrastructure\GestorFinanciero.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core Design para poder correr `dotnet ef migrations add` desde este proyecto -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- MudBlazor: Material Design component library for Blazor. -->
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

</Project>

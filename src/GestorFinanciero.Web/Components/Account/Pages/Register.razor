@page "/Account/Register"
@layout AuthLayout
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using System.Security.Cryptography
@using System.Text
@using GestorFinanciero.Application.Interfaces
@using GestorFinanciero.Domain.Constants
@using GestorFinanciero.Domain.Entities
@using GestorFinanciero.Infrastructure.Email
@using GestorFinanciero.Infrastructure.Identity
@using GestorFinanciero.Infrastructure.Persistence
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject UserManager<AppUser> UserManager
@inject AppDbContext Db
@inject IEmailService EmailService
@inject IAppEventLogger AppEvents
@inject ILogger<Register> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Crear cuenta — Gestor Financiero</PageTitle>

<MudPaper Elevation="4" Class="auth-card pa-8" Square="false">
    <MudStack Row AlignItems="AlignItems.Center" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.PersonAdd"
                 Color="Color.Primary"
                 Size="Size.Large" />
        <div>
            <MudText Typo="Typo.h5">Crear cuenta</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Paso 1 de 3 — decinos tu nombre y correo.
            </MudText>
        </div>
    </MudStack>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" Dense="true">
            @errorMessage
        </MudAlert>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="StartRegistrationAsync" FormName="register">
        <DataAnnotationsValidator />

        <MudStack Spacing="4">
            <MudTextField T="string"
                          Label="Nombre completo"
                          @bind-Value="Input.FullName"
                          For="() => Input.FullName"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "name", ["name"] = "Input.FullName" })" />

            <MudTextField T="string"
                          Label="Correo electrónico"
                          @bind-Value="Input.Email"
                          For="() => Input.Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          HelperText="Te vamos a enviar un código de 6 dígitos para confirmar."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "email", ["name"] = "Input.Email" })" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Send"
                       FullWidth="true">
                Enviar código
            </MudButton>
        </MudStack>
    </EditForm>

    <MudDivider Class="my-6" />

    <MudStack Row Justify="Justify.Center" Spacing="1">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">¿Ya tenés cuenta?</MudText>
        <MudLink Href="Account/Login" Underline="Underline.Hover">Iniciar sesión</MudLink>
    </MudStack>
</MudPaper>

@code {
    private const string GenericSuccessMessage =
        "Si el correo es válido, te enviamos un código de 6 dígitos.";

    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    public async Task StartRegistrationAsync()
    {
        var email = Input.Email.Trim().ToLowerInvariant();
        var fullName = Input.FullName.Trim();

        // If email is already a real user, don't leak that — behave identically
        // to a success case but do NOT send the code. Attacker can't enumerate.
        var alreadyRegistered = await UserManager.FindByEmailAsync(email) is not null;
        if (alreadyRegistered)
        {
            await AppEvents.LogAsync(
                module: EventModules.AuthRegister,
                action: EventActions.Failed,
                message: "Registration attempt for an existing email.",
                level: EventLevels.Warning,
                failureReason: "email_already_registered",
                userEmail: email);

            RedirectManager.RedirectTo(
                "Account/VerifyCode",
                new Dictionary<string, object?> { ["email"] = email });
            return;
        }

        // Generate a random 6-digit code (000000-999999). Use RNG, not Random,
        // so it's not guessable.
        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
        var codeHash = HashCode(code);

        // Upsert: if there's already a pending registration for this email,
        // reset it (new code, new expiry, attempts back to 0). This lets the
        // user retry cleanly without polluting the table.
        var pending = await Db.PendingRegistrations
            .SingleOrDefaultAsync(pr => pr.Email == email);

        if (pending is null)
        {
            pending = new PendingRegistration
            {
                Email     = email,
                FullName  = fullName,
                CodeHash  = codeHash,
                ExpiresAt = DateTime.UtcNow.AddMinutes(PendingRegistration.CodeLifetimeMinutes),
            };
            Db.PendingRegistrations.Add(pending);
        }
        else
        {
            pending.FullName          = fullName;
            pending.CodeHash          = codeHash;
            pending.ExpiresAt         = DateTime.UtcNow.AddMinutes(PendingRegistration.CodeLifetimeMinutes);
            pending.AttemptsCount     = 0;
            pending.IsVerified        = false;
            pending.VerificationToken = null;
        }

        await Db.SaveChangesAsync();

        try
        {
            await EmailService.SendAsync(
                email,
                "Tu código de verificación — Gestor Financiero",
                EmailTemplates.RegistrationCode(fullName, code, PendingRegistration.CodeLifetimeMinutes));

            await AppEvents.LogAsync(
                module: EventModules.AuthRegister,
                action: EventActions.Attempt,
                message: "Registration code sent.",
                userEmail: email);
        }
        catch (Exception emailEx)
        {
            Logger.LogWarning(emailEx, "Failed to send registration code to {Email}", email);
            await AppEvents.LogExceptionAsync(emailEx, EventModules.AuthRegister, level: EventLevels.Warning,
                userEmail: email);

            // Delete the pending row so the user isn't blocked from retrying.
            Db.PendingRegistrations.Remove(pending);
            await Db.SaveChangesAsync();

            errorMessage = "No pudimos enviar el correo con el código. Intentá de nuevo en unos minutos.";
            return;
        }

        RedirectManager.RedirectTo(
            "Account/VerifyCode",
            new Dictionary<string, object?> { ["email"] = email });
    }

    private static string HashCode(string code)
    {
        var bytes = SHA256.HashData(Encoding.UTF8.GetBytes(code));
        return Convert.ToHexString(bytes);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "El nombre es requerido.")]
        [StringLength(120, MinimumLength = 2, ErrorMessage = "El nombre debe tener entre {2} y {1} caracteres.")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "El correo es requerido.")]
        [EmailAddress(ErrorMessage = "Correo no válido.")]
        [StringLength(256)]
        public string Email { get; set; } = "";
    }
}

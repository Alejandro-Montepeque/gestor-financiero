@page "/Account/Lockout"
@layout AuthLayout
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

<PageTitle>Cuenta bloqueada</PageTitle>

<MudPaper Elevation="4" Class="auth-card pa-8 text-center">
    <MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Warning" Size="Size.Large" Class="mb-3" />
    <MudText Typo="Typo.h5" Class="mb-2">Cuenta bloqueada temporalmente</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
        Por seguridad, tu cuenta se bloqueó tras varios intentos fallidos.
        Esperá unos minutos y volvé a intentar.
    </MudText>
    <MudButton Href="Account/Login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">
        Volver al login
    </MudButton>
</MudPaper>

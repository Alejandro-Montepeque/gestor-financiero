@page "/Account/SetPassword"
@layout AuthLayout
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using GestorFinanciero.Application.Interfaces
@using GestorFinanciero.Domain.Constants
@using GestorFinanciero.Domain.Entities
@using GestorFinanciero.Infrastructure.Email
@using GestorFinanciero.Infrastructure.Identity
@using GestorFinanciero.Infrastructure.Persistence
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject IUserStore<AppUser> UserStore
@inject ICategorySeeder CategorySeeder
@inject AppDbContext Db
@inject IEmailService EmailService
@inject IAppEventLogger AppEvents
@inject ILogger<SetPassword> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Elegí tu contraseña — Gestor Financiero</PageTitle>

<MudPaper Elevation="4" Class="auth-card pa-8" Square="false">
    <MudStack Row AlignItems="AlignItems.Center" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.LockPerson"
                 Color="Color.Primary"
                 Size="Size.Large" />
        <div>
            <MudText Typo="Typo.h5">Elegí tu contraseña</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Paso 3 de 3 — creá tu contraseña para <strong>@_email</strong>.
            </MudText>
        </div>
    </MudStack>

    @if (_invalidToken)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
            El link expiró o ya se usó. Empezá de nuevo el registro.
        </MudAlert>
        <MudButton Href="Account/Register"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Refresh">
            Volver al registro
        </MudButton>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" Dense="true">
                @errorMessage
            </MudAlert>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="CreateAccountAsync" FormName="set-password">
            <DataAnnotationsValidator />

            <input type="hidden" name="Input.Token" value="@Input.Token" />

            <MudStack Spacing="4">
                <div class="gf-strength-wrap">
                    <div class="gf-password-field">
                        <MudTextField T="string"
                                      Label="Contraseña"
                                      @bind-Value="Input.Password"
                                      For="() => Input.Password"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      HelperText="Mínimo 8 caracteres, con al menos un número."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock"
                                      UserAttributes="@(new Dictionary<string, object?> {
                                          ["autocomplete"] = "new-password",
                                          ["name"] = "Input.Password",
                                          ["id"] = "setpassword-password",
                                          ["data-strength-meter"] = "true" })" />
                        <button type="button" class="gf-password-toggle" data-toggle-password="setpassword-password" aria-label="Mostrar contraseña" tabindex="-1">
                            <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                        </button>
                    </div>
                    <div class="gf-strength-bar gf-strength-0"></div>
                    <div class="gf-strength-label"></div>
                </div>

                <div class="gf-password-field">
                    <MudTextField T="string"
                                  Label="Confirmar contraseña"
                                  @bind-Value="Input.ConfirmPassword"
                                  For="() => Input.ConfirmPassword"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Lock"
                                  UserAttributes="@(new Dictionary<string, object?> {
                                      ["autocomplete"] = "new-password",
                                      ["name"] = "Input.ConfirmPassword",
                                      ["id"] = "setpassword-confirm" })" />
                    <button type="button" class="gf-password-toggle" data-toggle-password="setpassword-confirm" aria-label="Mostrar contraseña" tabindex="-1">
                        <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.CheckCircle"
                           FullWidth="true">
                    Crear cuenta y entrar
                </MudButton>
            </MudStack>
        </EditForm>
    }
</MudPaper>

@code {
    private const string GenericErrorMessage =
        "No pudimos crear la cuenta. Revisá los datos e intentá de nuevo.";

    private string? errorMessage;
    private bool _invalidToken;
    private string _email = "";

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "token")]
    private string? TokenFromQuery { get; set; }

    protected override void OnInitialized() => Input ??= new();

    protected override async Task OnParametersSetAsync()
    {
        // Only run validation on the initial GET; on POST the hidden input
        // preserves the token so this branch would re-lookup unnecessarily.
        if (!string.IsNullOrEmpty(Input.Token))
        {
            await ResolvePendingAsync(Input.Token);
            return;
        }

        if (TokenFromQuery is not null)
        {
            Input.Token = TokenFromQuery;
            await ResolvePendingAsync(TokenFromQuery);
        }
        else
        {
            _invalidToken = true;
        }
    }

    private async Task ResolvePendingAsync(string tokenRaw)
    {
        if (!Guid.TryParse(tokenRaw, out var token))
        {
            _invalidToken = true;
            return;
        }

        var pending = await Db.PendingRegistrations
            .AsNoTracking()
            .SingleOrDefaultAsync(pr => pr.VerificationToken == token);

        if (pending is null || !pending.IsVerified || pending.ExpiresAt < DateTime.UtcNow)
        {
            _invalidToken = true;
            return;
        }

        _email = pending.Email;
    }

    public async Task CreateAccountAsync()
    {
        if (!Guid.TryParse(Input.Token, out var token))
        {
            errorMessage = GenericErrorMessage;
            return;
        }

        var pending = await Db.PendingRegistrations
            .SingleOrDefaultAsync(pr => pr.VerificationToken == token);

        if (pending is null || !pending.IsVerified || pending.ExpiresAt < DateTime.UtcNow)
        {
            _invalidToken = true;
            return;
        }

        // Race guard: someone else may have already claimed this email between
        // step 1 and step 3. Same generic behavior — don't leak enumeration.
        if (await UserManager.FindByEmailAsync(pending.Email) is not null)
        {
            Db.PendingRegistrations.Remove(pending);
            await Db.SaveChangesAsync();
            _invalidToken = true;
            return;
        }

        var user = new AppUser
        {
            FullName = pending.FullName,
            // Email confirmed = true because the user proved control by
            // entering the code we mailed. Skip the ConfirmEmail flow.
            EmailConfirmed = true,
        };

        await UserStore.SetUserNameAsync(user, pending.Email, CancellationToken.None);
        var emailStore = (IUserEmailStore<AppUser>)UserStore;
        await emailStore.SetEmailAsync(user, pending.Email, CancellationToken.None);

        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            await AppEvents.LogAsync(
                module: EventModules.AuthRegister,
                action: EventActions.Failed,
                message: "Account creation failed: " + string.Join("; ", result.Errors.Select(e => e.Description)),
                level: EventLevels.Warning,
                failureReason: string.Join(",", result.Errors.Select(e => e.Code)),
                userEmail: pending.Email);

            // Show HIBP / password-quality errors verbatim so the user can fix them.
            errorMessage = result.Errors.FirstOrDefault()?.Description ?? GenericErrorMessage;
            return;
        }

        await AppEvents.LogAsync(
            module: EventModules.AuthRegister,
            action: EventActions.Created,
            message: "New account created (code-verified).",
            userId: user.Id,
            userEmail: pending.Email);

        await CategorySeeder.SeedForUserAsync(user.Id);

        // Consume the pending row — it's single-use.
        Db.PendingRegistrations.Remove(pending);
        await Db.SaveChangesAsync();

        // Fire-and-forget welcome email.
        try
        {
            await EmailService.SendAsync(
                pending.Email,
                "¡Bienvenido a Gestor Financiero!",
                EmailTemplates.Welcome(pending.FullName));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to send welcome email to {Email}", pending.Email);
        }

        // Auto sign-in — the account is created and verified, no need for a
        // separate login round-trip.
        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo("/");
    }

    private sealed class InputModel
    {
        [Required]
        public string Token { get; set; } = "";

        [Required(ErrorMessage = "La contraseña es requerida.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "La contraseña debe tener al menos {2} caracteres.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = "";
    }
}

@page "/Account/ForgotPasswordConfirmation"
@layout AuthLayout
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

<PageTitle>Revisá tu correo — Gestor Financiero</PageTitle>

<MudPaper Elevation="4" Class="auth-card pa-8 text-center">
    <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Color="Color.Success" Size="Size.Large" Class="mb-3" />
    <MudText Typo="Typo.h5" Class="mb-2">Revisá tu correo</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6" Style="max-width:400px;margin:0 auto">
        Si el email pertenece a una cuenta existente, te llegó un link para restablecer la contraseña.
        El link expira en 1 hora por seguridad.
    </MudText>
    <MudButton Href="Account/Login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">
        Volver al login
    </MudButton>
</MudPaper>

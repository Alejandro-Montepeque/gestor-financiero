@page "/Account/Manage/Password"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using GestorFinanciero.Application.Interfaces
@using GestorFinanciero.Domain.Constants
@using GestorFinanciero.Infrastructure.Email
@using GestorFinanciero.Infrastructure.Identity
@using GestorFinanciero.Web.Components.Account.Shared
@using Microsoft.AspNetCore.Identity

@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject IAppEventLogger AppEvents
@inject IEmailService EmailService
@inject ILogger<Password> Logger

<PageTitle>Cambiar contraseña — Gestor Financiero</PageTitle>

<MudGrid>
    <MudItem xs="12" md="3">
        <ManageNav />
    </MudItem>

    <MudItem xs="12" md="9">
        <MudStack Spacing="4">
            <div>
                <MudText Typo="Typo.h4">Contraseña</MudText>
                <MudText Typo="Typo.body1" Class="mud-text-secondary mt-1">
                    Cambiá tu contraseña. Vamos a validar que no esté filtrada en Have I Been Pwned.
                </MudText>
            </div>

            <StatusMessage />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">
                    @_errorMessage
                </MudAlert>
            }

            <MudPaper Elevation="0" Class="gf-panel pa-6">
                <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="manage-password">
                    <DataAnnotationsValidator />

                    <MudStack Spacing="4">
                        <div class="gf-password-field">
                        <MudTextField T="string"
                                      Label="Contraseña actual"
                                      @bind-Value="Input.OldPassword"
                                      For="() => Input.OldPassword"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock"
                                      UserAttributes="@(new Dictionary<string, object?> {
                                          ["autocomplete"] = "current-password",
                                          ["name"] = "Input.OldPassword",
                                          ["id"] = "manage-old-password" })" />
                        <button type="button" class="gf-password-toggle" data-toggle-password="manage-old-password" aria-label="Mostrar contraseña" tabindex="-1">
                            <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                        </button>
                    </div>

                    <div class="gf-strength-wrap">
                        <div class="gf-password-field">
                            <MudTextField T="string"
                                          Label="Nueva contraseña"
                                          @bind-Value="Input.NewPassword"
                                          For="() => Input.NewPassword"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Password"
                                          HelperText="Mínimo 8 caracteres, con al menos un número."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Outlined.Lock"
                                          UserAttributes="@(new Dictionary<string, object?> {
                                              ["autocomplete"] = "new-password",
                                              ["name"] = "Input.NewPassword",
                                              ["id"] = "manage-new-password",
                                              ["data-strength-meter"] = "true" })" />
                            <button type="button" class="gf-password-toggle" data-toggle-password="manage-new-password" aria-label="Mostrar contraseña" tabindex="-1">
                                <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            </button>
                        </div>
                        <div class="gf-strength-bar gf-strength-0"></div>
                        <div class="gf-strength-label"></div>
                    </div>

                    <div class="gf-password-field">
                        <MudTextField T="string"
                                      Label="Confirmar nueva contraseña"
                                      @bind-Value="Input.ConfirmPassword"
                                      For="() => Input.ConfirmPassword"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Outlined.Lock"
                                      UserAttributes="@(new Dictionary<string, object?> {
                                          ["autocomplete"] = "new-password",
                                          ["name"] = "Input.ConfirmPassword",
                                          ["id"] = "manage-confirm-password" })" />
                        <button type="button" class="gf-password-toggle" data-toggle-password="manage-confirm-password" aria-label="Mostrar contraseña" tabindex="-1">
                            <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                        </button>
                    </div>

                        <MudStack Row Justify="Justify.FlexEnd">
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save">
                                Actualizar contraseña
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </EditForm>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private AppUser _user = default!;
    private string? _errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // See Index.razor: two-phase init so EditForm doesn't hit a null Model on
    // the first render, while keeping the [SupplyParameterFromForm] contract clean.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }

    private async Task OnValidSubmitAsync()
    {
        var result = await UserManager.ChangePasswordAsync(_user, Input.OldPassword, Input.NewPassword);

        if (!result.Succeeded)
        {
            var reason = string.Join(",", result.Errors.Select(e => e.Code));

            await AppEvents.LogAsync(
                module: EventModules.AuthPassword,
                action: EventActions.Failed,
                message: "Password change failed: " + string.Join("; ", result.Errors.Select(e => e.Description)),
                level: EventLevels.Warning,
                failureReason: reason,
                userId: _user.Id,
                userEmail: _user.Email);

            // Show only the safest error to the user.
            _errorMessage = reason.Contains("PasswordMismatch", StringComparison.OrdinalIgnoreCase)
                ? "La contraseña actual no es correcta."
                : result.Errors.FirstOrDefault()?.Description
                    ?? "No pudimos actualizar la contraseña.";
            return;
        }

        await AppEvents.LogAsync(
            module: EventModules.AuthPassword,
            action: EventActions.Updated,
            message: "Password changed from account panel.",
            userId: _user.Id,
            userEmail: _user.Email);

        await SignInManager.RefreshSignInAsync(_user);
        Logger.LogInformation("User changed their password successfully.");

        // Fire-and-forget security notification — never fail the user flow if SMTP is down.
        try
        {
            var ip = HttpContext.Connection.RemoteIpAddress?.ToString() ?? "—";
            var ua = HttpContext.Request.Headers.UserAgent.ToString();
            await EmailService.SendAsync(
                _user.Email!,
                "Tu contraseña fue cambiada — Gestor Financiero",
                EmailTemplates.PasswordChanged(_user.FullName, ip, ua, DateTime.UtcNow));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to send password-changed notice to {Email}", _user.Email);
            await AppEvents.LogExceptionAsync(ex, EventModules.AuthPassword, level: EventLevels.Warning,
                userId: _user.Id, userEmail: _user.Email);
        }

        RedirectManager.RedirectToCurrentPageWithStatus("Contraseña actualizada.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "La contraseña actual es requerida.")]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "La nueva contraseña es requerida.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Debe tener al menos {2} caracteres.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = "";
    }
}

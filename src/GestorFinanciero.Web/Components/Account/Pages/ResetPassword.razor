@page "/Account/ResetPassword"
@layout AuthLayout
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using System.Text
@using GestorFinanciero.Application.Interfaces
@using GestorFinanciero.Domain.Constants
@using GestorFinanciero.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<AppUser> UserManager
@inject IAppEventLogger AppEvents
@inject ILogger<ResetPassword> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Restablecer contraseña — Gestor Financiero</PageTitle>

<MudPaper Elevation="4" Class="auth-card pa-8" Square="false">
    <MudStack Row AlignItems="AlignItems.Center" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.LockOpen" Color="Color.Primary" Size="Size.Large" />
        <div>
            <MudText Typo="Typo.h5">Nueva contraseña</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Elegí una nueva contraseña para tu cuenta.
            </MudText>
        </div>
    </MudStack>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" Dense="true">
            @errorMessage
        </MudAlert>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="reset-password">
        <DataAnnotationsValidator />

        <input type="hidden" name="Input.Email" value="@Input.Email" />
        <input type="hidden" name="Input.Code" value="@Input.Code" />

        <MudStack Spacing="4">
            <MudTextField T="string"
                          Label="Correo electrónico"
                          Value="Input.Email"
                          Variant="Variant.Outlined"
                          ReadOnly="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email" />

            <div class="gf-strength-wrap">
                <MudTextField T="string"
                              Label="Nueva contraseña"
                              @bind-Value="Input.Password"
                              For="() => Input.Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              HelperText="Mínimo 8 caracteres, con al menos un número."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              UserAttributes="@(new Dictionary<string, object?> {
                                  ["autocomplete"] = "new-password",
                                  ["name"] = "Input.Password",
                                  ["data-strength-meter"] = "true" })" />
                <div class="gf-strength-bar gf-strength-0"></div>
                <div class="gf-strength-label"></div>
            </div>

            <MudTextField T="string"
                          Label="Confirmar contraseña"
                          @bind-Value="Input.ConfirmPassword"
                          For="() => Input.ConfirmPassword"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Lock"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password", ["name"] = "Input.ConfirmPassword" })" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Save"
                       FullWidth="true">
                Guardar nueva contraseña
            </MudButton>
        </MudStack>
    </EditForm>
</MudPaper>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "email")]
    private string? EmailFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? CodeFromQuery { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();

        // Hydrate email + code from the URL only on the initial GET; on POST the
        // form re-supplies them via hidden inputs so the round trip preserves state.
        if (string.IsNullOrEmpty(Input.Email))  Input.Email = EmailFromQuery ?? "";
        if (string.IsNullOrEmpty(Input.Code))   Input.Code  = CodeFromQuery ?? "";

        if (string.IsNullOrEmpty(Input.Code))
        {
            errorMessage = "El link no es válido o expiró. Pedí uno nuevo.";
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            // Same error for missing user and bad token → don't leak account existence.
            await AppEvents.LogAsync(
                module: EventModules.AuthPassword,
                action: EventActions.Failed,
                message: "Password reset for unknown email.",
                level: EventLevels.Warning,
                failureReason: "user_not_found",
                userEmail: Input.Email);

            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        string decodedToken;
        try
        {
            decodedToken = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Input.Code));
        }
        catch (FormatException)
        {
            errorMessage = "El link no es válido o expiró.";
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, decodedToken, Input.Password);

        if (result.Succeeded)
        {
            await AppEvents.LogAsync(
                module: EventModules.AuthPassword,
                action: EventActions.Success,
                message: "Password reset OK.",
                userId: user.Id,
                userEmail: user.Email);

            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        await AppEvents.LogAsync(
            module: EventModules.AuthPassword,
            action: EventActions.Failed,
            message: "Password reset failed: " + string.Join("; ", result.Errors.Select(e => e.Description)),
            level: EventLevels.Warning,
            failureReason: string.Join(",", result.Errors.Select(e => e.Code)),
            userId: user.Id,
            userEmail: user.Email);

        errorMessage = result.Errors.FirstOrDefault()?.Description
                    ?? "No pudimos guardar la nueva contraseña.";
    }

    private sealed class InputModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "La contraseña es requerida.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Debe tener al menos {2} caracteres.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = "";

        [Required]
        public string Code { get; set; } = "";
    }
}

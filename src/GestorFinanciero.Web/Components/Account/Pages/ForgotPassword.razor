@page "/Account/ForgotPassword"
@layout AuthLayout
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using GestorFinanciero.Application.Interfaces
@using GestorFinanciero.Domain.Constants
@using GestorFinanciero.Infrastructure.Email
@using GestorFinanciero.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<AppUser> UserManager
@inject IEmailService EmailService
@inject IAppEventLogger AppEvents
@inject ILogger<ForgotPassword> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Recuperar contraseña — Gestor Financiero</PageTitle>

<MudPaper Elevation="4" Class="auth-card pa-8" Square="false">
    <MudStack Row AlignItems="AlignItems.Center" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Large" />
        <div>
            <MudText Typo="Typo.h5">¿Olvidaste tu contraseña?</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Te mandamos un link para restablecerla.
            </MudText>
        </div>
    </MudStack>

    <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="forgot-password">
        <DataAnnotationsValidator />

        <MudStack Spacing="4">
            <MudTextField T="string"
                          Label="Correo electrónico"
                          @bind-Value="Input.Email"
                          For="() => Input.Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "username", ["name"] = "Input.Email" })" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Send"
                       FullWidth="true">
                Enviar link
            </MudButton>
        </MudStack>
    </EditForm>

    <MudDivider Class="my-6" />

    <MudStack Row Justify="Justify.Center" Spacing="1">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">¿Ya te acordaste?</MudText>
        <MudLink Href="Account/Login" Underline="Underline.Hover">Iniciar sesión</MudLink>
    </MudStack>
</MudPaper>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task OnValidSubmitAsync()
    {
        var email = Input.Email.Trim();

        // Look up the user but ALWAYS take the user to the confirmation page —
        // never reveal whether the email exists (account-enumeration protection).
        var user = await UserManager.FindByEmailAsync(email);

        if (user is not null)
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var encodedToken = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));

            var resetUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?>
                {
                    ["email"] = email,
                    ["code"] = encodedToken,
                });

            try
            {
                await EmailService.SendAsync(
                    email,
                    "Restablecé tu contraseña de Gestor Financiero",
                    EmailTemplates.PasswordReset(user.FullName, resetUrl));

                await AppEvents.LogAsync(
                    module: EventModules.AuthPassword,
                    action: EventActions.Attempt,
                    message: "Password reset link sent.",
                    userId: user.Id,
                    userEmail: email);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to send reset email to {Email}", email);
                await AppEvents.LogExceptionAsync(ex, module: "Email.PasswordReset", level: EventLevels.Error);
            }
        }
        else
        {
            // Still log the attempt for audit (with reason) but user sees the same UI.
            await AppEvents.LogAsync(
                module: EventModules.AuthPassword,
                action: EventActions.Attempt,
                message: "Password reset requested for unknown email.",
                level: EventLevels.Warning,
                failureReason: "user_not_found",
                userEmail: email);
        }

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "El correo es requerido.")]
        [EmailAddress(ErrorMessage = "Correo no válido.")]
        public string Email { get; set; } = "";
    }
}

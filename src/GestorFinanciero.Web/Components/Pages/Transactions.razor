@page "/transactions"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using GestorFinanciero.Application.DTOs
@using GestorFinanciero.Application.Interfaces
@using GestorFinanciero.Domain.Enums

@inject ITransactionService TransactionService
@inject ICategoryService CategoryService

<PageTitle>Transacciones</PageTitle>

<div class="page-header">
    <h1>Transacciones</h1>
    <button class="btn btn-primary" @onclick="StartCreate" disabled="@(categoryList.Count == 0)">
        + Nueva transacción
    </button>
</div>

<div class="filters">
    <div>
        <label>Desde</label>
        <input type="date" class="form-control" value="@FormatFilterDate(filter.From)" @onchange="OnFromChanged" />
    </div>
    <div>
        <label>Hasta</label>
        <input type="date" class="form-control" value="@FormatFilterDate(filter.To)" @onchange="OnToChanged" />
    </div>
    <div>
        <label>Categoría</label>
        <select class="form-control" @onchange="OnCategoryFilterChanged">
            <option value="">Todas</option>
            @foreach (var cat in categoryList)
            {
                <option value="@cat.Id" selected="@(filter.CategoryId == cat.Id)">@cat.Name</option>
            }
        </select>
    </div>
    <div class="d-flex align-items-end">
        <button class="btn btn-outline-secondary" @onclick="ClearFilters">Limpiar</button>
    </div>
</div>

@if (loading)
{
    <p>Cargando…</p>
}
else if (transactions.Count == 0)
{
    <p>Sin transacciones para el filtro actual.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Categoría</th>
                <th>Descripción</th>
                <th class="text-end">Monto</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tx in transactions)
            {
                <tr>
                    <td>@tx.Date.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="cat-swatch" style="@($"background:{tx.CategoryColor}")"></span>
                        @tx.CategoryName
                    </td>
                    <td>@(tx.Description ?? "—")</td>
                    <td class="text-end @(IsIncome(tx.CategoryType) ? "text-success" : "text-danger")">
                        @(IsIncome(tx.CategoryType) ? "+" : "-") @tx.Amount.ToString("N2", CultureInfo.InvariantCulture) @tx.Currency
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(tx)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => Delete(tx.Id)">Borrar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (editing is not null)
{
    <div class="modal-backdrop-fake" @onclick="CancelEdit"></div>
    <div class="modal-fake">
        <h2>@(editing.Id is null ? "Nueva transacción" : "Editar transacción")</h2>

        <EditForm Model="editing" OnValidSubmit="SaveEdit">
            <DataAnnotationsValidator />
            <ValidationSummary class="form-errors" />

            <div class="field">
                <label>Categoría</label>
                <InputSelect @bind-Value="editing.CategoryId" class="form-control">
                    <option value="">-- Elegí una categoría --</option>
                    @foreach (var cat in categoryList)
                    {
                        <option value="@cat.Id">@cat.Name (@TypeLabel(cat.Type))</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => editing.CategoryId" class="field-error" />
            </div>

            <div class="field">
                <label>Fecha</label>
                <InputDate @bind-Value="editing.Date" class="form-control" />
            </div>

            <div class="field">
                <label>Monto</label>
                <InputNumber @bind-Value="editing.Amount" class="form-control" step="0.01" />
                <ValidationMessage For="() => editing.Amount" class="field-error" />
            </div>

            <div class="field">
                <label>Moneda</label>
                <InputText @bind-Value="editing.Currency" class="form-control" maxlength="3" />
            </div>

            <div class="field">
                <label>Descripción</label>
                <InputText @bind-Value="editing.Description" class="form-control" placeholder="Ej: Netflix" />
            </div>

            <div class="field">
                <label>Notas (opcional)</label>
                <InputTextArea @bind-Value="editing.Notes" class="form-control" rows="2" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="modal-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancelar</button>
                <button type="submit" class="btn btn-primary" disabled="@saving">
                    @(saving ? "Guardando…" : "Guardar")
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    private List<TransactionDto> transactions = new();
    private List<CategoryDto> categoryList = new();
    private bool loading = true;
    private TransactionFilter filter = new();
    private TransactionFormModel? editing;
    private bool saving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        categoryList = (await CategoryService.GetAllAsync()).ToList();
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        transactions = (await TransactionService.ListAsync(filter)).ToList();
        loading = false;
    }

    private void StartCreate()
    {
        errorMessage = null;
        editing = new TransactionFormModel
        {
            Date = DateOnly.FromDateTime(DateTime.UtcNow),
            Currency = "USD",
            CategoryId = categoryList.FirstOrDefault()?.Id ?? Guid.Empty,
        };
    }

    private void StartEdit(TransactionDto tx)
    {
        errorMessage = null;
        editing = new TransactionFormModel
        {
            Id = tx.Id,
            CategoryId = tx.CategoryId,
            Amount = tx.Amount,
            Currency = tx.Currency,
            Date = tx.Date,
            Description = tx.Description,
            Notes = tx.Notes,
        };
    }

    private void CancelEdit() => editing = null;

    private async Task SaveEdit()
    {
        if (editing is null) return;

        saving = true;
        errorMessage = null;

        try
        {
            var dto = new TransactionUpsertDto
            {
                Id = editing.Id,
                CategoryId = editing.CategoryId,
                Amount = editing.Amount,
                Currency = editing.Currency,
                Date = editing.Date,
                Description = editing.Description,
                Notes = editing.Notes,
            };

            if (dto.Id is null)
                await TransactionService.CreateAsync(dto);
            else
                await TransactionService.UpdateAsync(dto);

            editing = null;
            await Reload();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Delete(Guid id)
    {
        try
        {
            await TransactionService.DeleteAsync(id);
            await Reload();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task OnFromChanged(ChangeEventArgs e)
    {
        filter.From = ParseFilterDate(e.Value?.ToString());
        await Reload();
    }

    private async Task OnToChanged(ChangeEventArgs e)
    {
        filter.To = ParseFilterDate(e.Value?.ToString());
        await Reload();
    }

    private async Task OnCategoryFilterChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        filter.CategoryId = Guid.TryParse(raw, out var id) ? id : null;
        await Reload();
    }

    private async Task ClearFilters()
    {
        filter = new TransactionFilter();
        await Reload();
    }

    private static string FormatFilterDate(DateOnly? d) => d?.ToString("yyyy-MM-dd") ?? "";

    private static DateOnly? ParseFilterDate(string? raw)
        => DateOnly.TryParse(raw, out var d) ? d : null;

    private static bool IsIncome(CategoryType t) => t is CategoryType.Income or CategoryType.Savings;

    private static string TypeLabel(CategoryType t) => t switch
    {
        CategoryType.Income          => "Ingreso",
        CategoryType.Savings         => "Ahorro",
        CategoryType.FixedExpense    => "Gasto fijo",
        CategoryType.VariableExpense => "Gasto variable",
        CategoryType.Debt            => "Deuda",
        _                            => t.ToString(),
    };

    private sealed class TransactionFormModel
    {
        public Guid? Id { get; set; }

        [Required(ErrorMessage = "Elegí una categoría.")]
        public Guid CategoryId { get; set; }

        [Range(0.01, double.MaxValue, ErrorMessage = "El monto debe ser mayor a 0.")]
        public decimal Amount { get; set; } = 0m;

        [Required, StringLength(3, MinimumLength = 3)]
        public string Currency { get; set; } = "USD";

        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);

        [StringLength(255)]
        public string? Description { get; set; }

        [StringLength(1000)]
        public string? Notes { get; set; }
    }
}
